# MARD capstone — environment template.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way;
# this file is tracked and must never contain a real credential.
#
#     cp .env.example .env
#
# Nothing here has a default. runlog.SpendCap.from_env refuses to run without
# an explicit ceiling on purpose (CONTEXT.md §4.2 item 3) — a "sensible
# default" for a spend cap is an invented decision that fails silently, which
# is the worst possible shape for a budget control.


# --- Backend ----------------------------------------------------------------
# Which provider the measurement campaign talks to: `openai` or `gemini`.
# Resolved in eval/backends.py; defaults to openai if unset. Nothing reaches
# Vertex unless this says gemini.
MARD_BACKEND=openai


# --- OpenAI (active backend — docs/17-OPENAI_PIVOT.md) ----------------------
# Use a key scoped to the shared MARD project, issued per person rather than
# shared between the four of us: a single key makes per-person spend
# unattributable, and O6 is an attribution objective.
#
# Set a HARD BUDGET LIMIT on that project in the OpenAI dashboard. MARD_SPEND_CAP_USD
# below is a client-side check inside our own scripts — it cannot see a call
# made from a notebook, an ad-hoc diagnostic, or another machine. The dashboard
# limit is the only ceiling that refuses calls at the API.
OPENAI_API_KEY=sk-proj-REPLACE_ME


# --- Vertex AI (retained, opt-in — only read when MARD_BACKEND=gemini) ------
# Kept so the 122 runs in runs/ and every finding in docs/16 stay reproducible.
# GOOGLE_APPLICATION_CREDENTIALS_JSON is the full service-account JSON on ONE
# line. Location is `global`: gemini-3.6-flash 404s on us-central1 for this
# project (issue #11).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}


# --- Spend ------------------------------------------------------------------
# The ceiling is Anugrah's decision (CONTEXT.md §4.2 item 3). Set by hand, and
# recorded with who set it and when, so a change is an explicit act rather than
# a diff riding along in an unrelated commit.
#
# Ledgers are per-backend and do not mix: runs/_ledger.json is Vertex
# (redeemable credit), runs-openai/_ledger.json is OpenAI (cash). See
# eval/backends.py for why.
MARD_SPEND_CAP_USD=5
MARD_SPEND_CAP_SET_BY=your name (track N)
MARD_SPEND_CAP_SET_ON=YYYY-MM-DD
MARD_SPEND_CAP_NOTE=what this ceiling is for, and whether it is cash or credit


# --- Optional overrides ------------------------------------------------------
# Model overrides, honoured by scripts/verify_rlm_*.py so the W5 optional 2x2
# sweep can reuse them unchanged. Leave unset to use the pair in eval/backends.py.
# MARD_TIER1_MODEL=gpt-5.6-terra
# MARD_TIER2_MODEL=gpt-5.6-luna
#
# Ledger/runs directory. Defaults to the active backend's own root; set only to
# re-price or re-analyse a directory other than the current backend's.
# MARD_RUNS_ROOT=runs-openai
