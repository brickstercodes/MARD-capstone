# Run artefacts are large, machine-generated, and reproducible from the manifest.
# The directory itself is tracked so paths resolve on a fresh clone.
runs/*
!runs/.gitkeep

# Parsed corpus is regenerated by the ingest pipeline; source PDFs are fetched,
# not vendored, so licence provenance stays with the upstream distributor.
corpus/parsed/
corpus/raw/

# Secrets. The spend cap lives in config; the keys never do.
# Glob rather than the exact name: an editor backup, a .env.local or a hand-made
# .env.bak is the same credential with a different suffix, and the narrow rule
# would have let it through.
.env
.env.*
.envrc
*.key
.secrets/

# The RLM base library is cloned here by scripts/bootstrap_rlm.sh. It is upstream
# code with its own history — the commit SHA is recorded in runs/_bootstrap/
# instead, which is what reproducibility actually needs.
.vendor/

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

.DS_Store

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
