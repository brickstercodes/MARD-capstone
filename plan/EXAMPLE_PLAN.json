  "study_sequence": [
    {
      "position": 1,
      "concept_id": "processes",
      "directive": "Define what a process is and how it differs from a program. Cover process state and the state transitions."
    },
    {
      "position": 2,
      "concept_id": "process-api",
      "directive": "Explain fork, exec and wait, and why the API separates process creation from program loading."
    },
    {
      "position": 3,
      "concept_id": "address-spaces",
      "directive": "Introduce the address space as the second virtualisation the OS provides, alongside the process. Assume the process abstraction is known; assume nothing about paging."
    },
    {
      "position": 4,
      "concept_id": "limited-direct-execution",
      "directive": "Explain how the OS keeps control of the CPU while running user code: traps, mode switches and the timer interrupt."
    },
    {
      "position": 5,
      "concept_id": "cpu-scheduling",
      "directive": "Cover FIFO, SJF and round robin, with the turnaround and response time metrics that separate them."
    },
    {
      "position": 6,
      "concept_id": "multi-level-feedback",
      "directive": "Build MLFQ from the limitations of the simple policies covered immediately before this."
    }
  ],
